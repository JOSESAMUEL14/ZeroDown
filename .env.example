# ZeroDown Environment Configuration (Placeholder Template)

# Application Settings
PORT=3000
APP_VERSION=v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zerodown
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=2000

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# Manager / DevOps Console Configuration
MANAGER_USERNAME=admin
MANAGER_PASSWORD=your_secure_devops_password
